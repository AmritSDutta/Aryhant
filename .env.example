# User-provided Gemini key (Google AI Studio)
USER_LLM_API_KEY=your-gemini-api-key-here
USER_LLM_MODEL=gemini-flash-lite-latest

# Optional: only if you use an OpenAI-compatible gateway
USER_LLM_BASE_URL=

# Slack Socket Mode (local always-on process only)
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-level-token

# Cloud Run HTTP Events API (scale-to-zero). Signing secret verifies Slack.
SLACK_SIGNING_SECRET=your-slack-signing-secret

# Shared secret for QStash / Cloudflare / Cloud Scheduler wake-ups
WEBHOOK_SHARED_SECRET=change-me

# Low-cost IMAP/SMTP email alternative (Gmail app password works)
EMAIL_ENABLED=false
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_IMAP_PORT=993
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_ADDRESS=your-bot@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_POLL_SECONDS=60
EMAIL_ALLOWED_SENDERS=
EMAIL_MAX_BODY_CHARS=4000

# Cost controls
MAX_INPUT_CHARS=4000
MAX_OUTPUT_TOKENS=256
REPLY_ONLY_TO_MENTIONS=true
